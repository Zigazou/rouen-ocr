#!/usr/bin/env bash

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python_bin="$project_root/.venv/bin/python"

if [[ ! -x "$python_bin" ]]; then
    python_bin="python3"
fi

PYTHONPATH="$project_root/src${PYTHONPATH:+:$PYTHONPATH}" \
    exec "$python_bin" -m rouen_ocr.pdf_to_text "$@"
